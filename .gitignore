# Environment & credentials — never commit real secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
id_rsa*
*_do
*_do.pub

# Private / personal notes — keep anything confidential in private/
private/

# Virtual environment
venv/
.venv/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Data (personal — not for version control)
*.db
*.csv

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Node (Tailwind build tooling — built CSS is committed, not node_modules)
node_modules/

# Claude Code local settings
.claude/settings.local.json
