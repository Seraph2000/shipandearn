# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
DATABASE_URL=postgresql://localhost/earnstack
SECRET_KEY=change-me-in-production

# ── Stripe ────────────────────────────────────────────────────────────────────
# Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create these in Stripe Dashboard → Products
STRIPE_PRICE_LIFETIME=price_...
STRIPE_PRICE_PRO=price_...

# Promo pricing — leave blank to disable promos entirely.
# Lifetime flash sale and Pro trial+discount, each with its own end date
# (YYYY-MM-DD). Update the date any time to extend/end a promo — no deploy
# of code logic required.
STRIPE_PRICE_LIFETIME_PROMO=price_...
STRIPE_PRICE_LIFETIME_STANDARD=price_...
LIFETIME_PROMO_END=2026-09-30

STRIPE_PRICE_PRO_PROMO=price_...
PRO_PROMO_END=2026-09-30
PRO_TRIAL_DAYS=14
