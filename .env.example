# ── AI (required for summarisation/drafting) ──────────────────────────────────
# Get key at: console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Prolific ──────────────────────────────────────────────────────────────────
# 1. Log in at app.prolific.com
# 2. Open devtools (F12) > Application > Cookies > prolific.com
# 3. Copy the value of the "sessionid" cookie
PROLIFIC_SESSION_COOKIE=

# ── Clickworker ───────────────────────────────────────────────────────────────
CLICKWORKER_EMAIL=
CLICKWORKER_PASSWORD=

# ── Freecash ──────────────────────────────────────────────────────────────────
# No key needed — public offer wall. Just sign up free at freecash.com.

# ── Swagbucks ─────────────────────────────────────────────────────────────────
SWAGBUCKS_EMAIL=
SWAGBUCKS_PASSWORD=

# ── PrizeRebel ────────────────────────────────────────────────────────────────
PRIZEREBEL_EMAIL=
PRIZEREBEL_PASSWORD=

# ── InboxDollars ──────────────────────────────────────────────────────────────
INBOXDOLLARS_EMAIL=
INBOXDOLLARS_PASSWORD=

# ── UserTesting ───────────────────────────────────────────────────────────────
# IMAP credentials for the email account that receives UserTesting alerts.
# Use an app password if the account has 2FA (e.g. Gmail app password).
USERTESTING_IMAP_HOST=imap.gmail.com
USERTESTING_IMAP_EMAIL=
USERTESTING_IMAP_PASSWORD=

# ── Outlier.ai ────────────────────────────────────────────────────────────────
OUTLIER_EMAIL=
OUTLIER_PASSWORD=

# ── DataAnnotation.tech ───────────────────────────────────────────────────────
DATAANNOTATION_EMAIL=
DATAANNOTATION_PASSWORD=

# ── Appen ─────────────────────────────────────────────────────────────────────
APPEN_EMAIL=
APPEN_PASSWORD=

# ── Respondent.io ─────────────────────────────────────────────────────────────
# 1. Log in at app.respondent.io
# 2. Open devtools > Application > Cookies > respondent.io
# 3. Copy the value of the session cookie (typically "_respondent_session")
RESPONDENT_SESSION_COOKIE=

# ── Optional overrides ────────────────────────────────────────────────────────
# DB_PATH=meo.db
# EARNINGS_CSV=earnings.csv
# POLL_PROLIFIC_SECS=120
# POLL_CLICKWORKER_SECS=600
# POLL_FREECASH_SECS=300
# POLL_SWAGBUCKS_SECS=600
# POLL_PRIZEREBEL_SECS=600
# POLL_INBOXDOLLARS_SECS=600
# POLL_OUTLIER_SECS=300
# POLL_DATAANNOTATION_SECS=300
# POLL_APPEN_SECS=1800
# POLL_RESPONDENT_SECS=1800
